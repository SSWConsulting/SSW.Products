# Enough to run `pnpm dev` and view the site locally. Neither value is secret.
# Copy to .env.local. Editing content through the TinaCMS UI additionally needs
# NEXT_PUBLIC_TINA_CLIENT_ID and TINA_TOKEN - see .env.example.
NEXT_PUBLIC_PRODUCT_LIST='[{"product": "YakShaver", "domain": "localhost:3000"}]'
DEFAULT_PRODUCT="YakShaver"
